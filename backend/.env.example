# --- Ứng dụng NestJS ---
PORT=3000

# ============================================
# MẬT KHẨU DÙNG CHUNG (chỉ cho dev local)
# Đổi 4 biến bên dưới thành CÙNG một giá trị.
# Ràng buộc: MinIO yêu cầu >= 8 ký tự.
# ============================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=lms_dev_password
DB_NAME=elearning_lms
DB_PORT=5433

# --- Redis ---
REDIS_PASSWORD=lms_dev_password
REDIS_PORT=6379

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=lms_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Bull Board ---
BULL_BOARD_PASSWORD=lms_dev_password
BULL_BOARD_PORT=3001

# --- NestJS Observe ---
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
