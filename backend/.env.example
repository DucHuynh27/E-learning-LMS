# --- Ứng dụng NestJS ---
PORT=3000

# CORS: danh sách origin phân tách bằng dấu phẩy.
# Để trống sẽ dùng mặc định dev: http://localhost:3000,http://localhost:3100
CORS_ORIGIN=

# Express `trust proxy`: chỉ tin X-Forwarded-For từ proxy thật.
# Để trống = tắt (an toàn). Đặt số hop (vd 1), 'loopback', hoặc danh sách IP/CIDR.
# KHÔNG đặt 'true' (cho phép client giả IP để né rate limit).
TRUST_PROXY=

# Rate limit storage: 'memory' (mặc định, đủ cho một instance)
# hoặc 'redis' để nhiều instance dùng chung bộ đếm.
THROTTLE_STORAGE=memory
# Chỉ dùng khi THROTTLE_STORAGE=redis, vd redis://:lms_dev_password@localhost:6379
THROTTLE_REDIS_URL=

# ============================================
# MẬT KHẨU DÙNG CHUNG (chỉ cho dev local)
# Đổi 4 biến bên dưới thành CÙNG một giá trị.
# Ràng buộc: MinIO yêu cầu >= 8 ký tự.
# ============================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=lms_dev_password
DB_NAME=elearning_lms
DB_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_USERNAME=
REDIS_TLS=false
REDIS_PASSWORD=lms_dev_password
REDIS_PORT=6379

# --- MinIO (S3-compatible) ---
MINIO_HOST=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=lms_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=lms-videos
MINIO_PRESIGNED_TTL=900

# --- Bull Board ---
BULL_BOARD_PASSWORD=lms_dev_password
BULL_BOARD_PORT=3001

# --- JWT ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- NestJS Observe ---
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
